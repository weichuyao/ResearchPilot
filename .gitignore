# ============================================================
# AI ChatKit / ResearchPilot
# ============================================================

# --- 环境变量 ---
# backend/.env 里有真实的 API 密钥，绝不能提交
/backend/.env
# backend/.env.example 是有意提交的（给别人看的配置模板）

# 根目录 .env 是 Docker Compose 的变量文件。里面没有密钥，但**是机器相关的**：
# 它主要是用来覆盖基础镜像来源的（本机 daemon 连不上 Docker Hub 的认证，
# 需要走国内镜像源）。换一台网络正常的机器就不需要它。
# 所以不跟踪 —— 让每台机器用 docker-compose.yml 里的默认值，有需要再自己建。
/.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
# 仓库声明 Python >=3.13，但本机实际运行在 .venv-py311（见 NOTES.md）
/backend/.venv
/backend/.venv-py311/

# 依赖缓存
/.uv-cache/

# --- 前端 ---
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/.pnpm-store/

# TypeScript 的增量编译缓存。tcs --noEmit 也会生成它，
# 内容是本机的文件时间戳和哈希，换台机器就没意义了。
/frontend/tsconfig.tsbuildinfo

# --- 运行时生成的数据 ---
# 后端日志（改造 #7）：运行时产物，轮转文件在 backend/logs/ 下
/backend/logs/

# Chroma 向量库可由 backend/tests/rag/importRag.py 从 EmployeeHandbook.pdf 重新生成
**/chroma_db/

# SQLite 运行时数据库。曾经是被跟踪的，但它每次导入论文都会变（paper 表的块数），
# 二进制 diff 没有可读性，而且把「数据」混进了「代码」的历史里。
# 重建方式：先跑 ingestion（会自动建表并写入 paper 记录）。
#   python app/ai/rag/ingest.py
/backend/resource/database.db

# 早期因工作目录不对而产生的残留产物
/backend/app/resource/

# --- 模型权重 ---
# 交叉编码器重排模型（int8 ONNX，266 MB + 16 MB 分词器）。
# 二进制权重不进版本库，用 scripts/fetch-reranker.ps1 下载。
# 代价是全新 clone 出来的仓库没有这个模型 —— 所以 ai/rag/rerank.py 必须能
# 在模型缺失时静默降级回纯混合检索，而不是报错。
/backend/resource/models/

# --- 用户上传的文档 ---
# 通过 POST /documents 上传的 PDF。和数据库一样属于运行时数据：
# 内容可重建（重新上传），而且用户传的东西不该进版本库。
# 命名是 <内容哈希前12位>_<清洗过的原名>.pdf，所以同名不同内容不会互相覆盖。
/backend/resource/uploads/

# --- 编辑器 / 操作系统 ---
/.vscode/
/.idea/
.DS_Store
Thumbs.db
# --- 根目录的临时产物 ---
# 我排查构建问题时留下的日志。加进来是为了避免下次又误提交 ——
# 今天已经犯过一次（把 tsconfig.tsbuildinfo 提交了）。
/_*.log
/*_build.log
/_*.txt

# 临时诊断脚本（探针/一次性验证，不属于项目产物）
/tmp/

# 论文 PDF 不入库：开发用的都是已发表作品，公开仓库不再分发（语料自备，见 README）
/backend/resource/papers/*.pdf

# 个人机器文件与测试运行产物，不属于项目
/registry-backup/
/.qa_state.json

# 改造 #11：微调产物（训练数据由受版权保护的论文派生，权重是二进制大文件）
/finetune/data/
/finetune/output/
/finetune/models/
