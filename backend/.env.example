# Environment variable configuration

# Database configuration
#
# 默认 SQLite：不需要任何外部依赖，适合本地开发和跑测试。
DATABASE_URL=sqlite+aiosqlite:///resource/database.db
#
# PostgreSQL：docker compose 起来的那个库（改造 #6 引入）。
# 宿主机的端口映射到 5433 而不是 5432，避免和已有的 postgres 冲突。
#   DATABASE_URL=postgresql+asyncpg://researchpilot:researchpilot@127.0.0.1:5433/researchpilot
#
# 在容器内跑时主机名换成服务名 postgres、端口用容器内的 5432：
#   DATABASE_URL=postgresql+asyncpg://researchpilot:researchpilot@postgres:5432/researchpilot
#
# MySQL（历史遗留，未验证）
# DATABASE_URL=mysql+aiomysql://root:root@localhost/ai-chatkit

# Application configuration
DEBUG=True
APP_NAME=ResearchPilot

# Logging (transformation #7)
# LOG_DIR is relative to backend/; inside the container it is bind-mounted
# (./backend/logs:/app/logs in docker-compose.yml) so logs survive restarts.
LOG_DIR=logs
LOG_LEVEL=INFO

# OpenAI
OPENAI_BASE_URL=
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# DashScope
#DASHSCOPE_API_KEY=
#DEFAULT_MODEL=qwen-plus

#DeepSeek
#DEEPSEEK_API_KEY=
#DEFAULT_MODEL=deepseek-chat





# Use bge-m3 as the embedding model, supporting both Chinese and English; requires local deployment of the bge-m3 model via Ollama
EMBEDDING_MODEL=bge-m3

# Relative storage path for ChromaDB
CHROMA_PATH=resource/chroma_db

# Vector store backend (transformation #6): "chroma" (default, embedded) | "qdrant".
# Qdrant runs via `docker compose up -d qdrant`; comparison results in
# reference/transformation-06-qdrant-design.md
#VECTOR_STORE=chroma
#QDRANT_URL=http://127.0.0.1:6333
#QDRANT_EXACT=false
# MCP (transformation #4): arXiv tools via stdio server (uvx pulls the package
# on first run). Disabled in eval/test entrypoints. research-workflow stays
# local-only by design - see reference/transformation-04-mcp-arxiv-design.md
#MCP_ARXIV_ENABLED=true
#MCP_ARXIV_COMMAND=uvx arxiv-mcp-server
